PORT=3001
# Only configure a known, trusted reverse proxy hop count.
TRUST_PROXY_HOPS=0
# Per-process protections; add shared or edge limiting for multi-instance hosting.
API_RATE_WINDOW_MINUTES=15
API_RATE_ANALYZE_MAX=12
API_RATE_AI_MAX=10
API_RATE_SHARES_MAX=20
API_CONCURRENT_ANALYZE_MAX=4
API_CONCURRENT_AI_MAX=2
API_CONCURRENT_SHARES_MAX=8
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Needed for photo OCR. Alternatively set GOOGLE_CREDENTIALS_JSON in the host's secret settings.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Optional AI fallback for fields the deterministic extractor could not read.
AI_EXTRACTION_ENABLED=false
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
# Needed only for server-backed report links.
DATABASE_URL=
SHARE_REPORT_TTL_DAYS=90
